#!/usr/bin/env python3
"""rice-backup: your whole setup in one file, and back (Settings > System > Care), V6.00.

  rice-backup save [FOLDER]   a .dsbackup file (default folder: ~/DarkShadow-backups); prints its path
  rice-backup list            JSON: the backups in that folder, the newest first
  rice-backup restore FILE    put that setup back (your setup right now is saved first, as "before-restore"),
                              then the shell, the bar and the wallpaper start again with it

In it: ~/.config/rice (every setting, your themes and presets), the Hyprland files Settings writes
(~/.config/hypr/rice-*.lua and rice-*.conf), your avatar, and the wallpaper you use (the picture itself, so it
still works on a new computer). Not in it: your files, passwords, Wi-Fi networks, or the shell itself.
"""
import io
import json
import os
import shutil
import subprocess
import sys
import tarfile
import time

HOME = os.path.expanduser("~")
BIN = HOME + "/.local/bin/"
DEFAULT_DIR = HOME + "/DarkShadow-backups"
FORMAT = 1
MAX_RESTORE = 400 * 1024 * 1024          # a backup is a few MB; anything this big is not one of ours
CURRENT = HOME + "/.cache/hyprquickpaper-current"


def what():
    """(path in the archive, real path) of every file that goes in"""
    out = []
    rice = HOME + "/.config/rice"
    for root, dirs, files in os.walk(rice):
        dirs[:] = [d for d in dirs if d not in ("cache", "tmp")]
        for f in files:
            p = os.path.join(root, f)
            if os.path.islink(p) or f.endswith((".tmp", ".lock")):
                continue
            out.append(("home/" + os.path.relpath(p, HOME), p))
    hypr = HOME + "/.config/hypr"
    if os.path.isdir(hypr):
        for f in sorted(os.listdir(hypr)):
            if f.startswith("rice-") and f.endswith((".lua", ".conf")) and os.path.isfile(os.path.join(hypr, f)):
                out.append(("home/.config/hypr/" + f, os.path.join(hypr, f)))
    for f in (".face", ".face.icon"):
        if os.path.isfile(HOME + "/" + f) and not os.path.islink(HOME + "/" + f):
            out.append(("home/" + f, HOME + "/" + f))
    return out


def wallpaper():
    try:
        p = open(CURRENT).read().strip()
    except OSError:
        return ""
    return p if os.path.isfile(p) and os.path.getsize(p) < 80 * 1024 * 1024 else ""


def save(folder, quiet=False):
    folder = os.path.abspath(os.path.expanduser(folder or DEFAULT_DIR))
    os.makedirs(folder, exist_ok=True)
    stem = "darkshadow-setup-" + time.strftime("%Y-%m-%d-%H%M%S")
    path, n = os.path.join(folder, stem + ".dsbackup"), 2
    while os.path.exists(path):           # never over another backup
        path, n = os.path.join(folder, "%s-%d.dsbackup" % (stem, n)), n + 1
    files = what()
    wall = wallpaper()
    try:
        ver = open(HOME + "/.config/rice/version").read().strip()
    except OSError:
        ver = ""
    meta = {"format": FORMAT, "app": "DarkShadow's Shell", "made": time.strftime("%Y-%m-%d %H:%M"), "version": ver,
            "host": os.uname().nodename, "wallpaper": os.path.basename(wall) if wall else "", "wallpaper_path": wall,
            "files": len(files)}
    tmp = path + ".part"
    with tarfile.open(tmp, "w:gz") as t:
        data = json.dumps(meta, indent=1).encode()
        ti = tarfile.TarInfo("backup.json"); ti.size = len(data); ti.mtime = int(time.time())
        t.addfile(ti, io.BytesIO(data))
        for arc, real in files:
            try:
                t.add(real, arcname=arc, recursive=False)
            except OSError:
                pass
        if wall:
            t.add(wall, arcname="wallpaper/" + os.path.basename(wall), recursive=False)
    os.replace(tmp, path)
    if not quiet:
        print(path)
    return path


def read_meta(path):
    try:
        with tarfile.open(path, "r:gz") as t:
            f = t.extractfile("backup.json")
            return json.loads(f.read().decode()) if f else None
    except (OSError, tarfile.TarError, KeyError, ValueError):
        return None


def cmd_list(folder):
    folder = os.path.abspath(os.path.expanduser(folder or DEFAULT_DIR))
    out = []
    if os.path.isdir(folder):
        for f in os.listdir(folder):
            if f.endswith(".dsbackup"):
                p = os.path.join(folder, f)
                m = read_meta(p) or {}
                out.append({"path": p, "name": f, "size": os.path.getsize(p), "made": m.get("made", ""),
                            "version": m.get("version", ""), "host": m.get("host", ""), "ok": bool(m),
                            "mtime": os.path.getmtime(p)})
    out.sort(key=lambda b: -b["mtime"])
    print(json.dumps({"folder": folder, "backups": out}))


def safe_members(t):
    """only plain files and folders, only under home/ or wallpaper/, never out of them"""
    good = []
    for m in t.getmembers():
        n = m.name
        if n == "backup.json":
            continue
        if not (m.isfile() or m.isdir()) or n.startswith("/") or ".." in n.split("/"):
            raise ValueError("this is not a DarkShadow backup (it has " + n + ")")
        if not (n.startswith("home/.config/rice/") or n.startswith("home/.config/hypr/rice-") or n in ("home/.face", "home/.face.icon")
                or (n.startswith("wallpaper/") and n.count("/") == 1)):
            raise ValueError("this is not a DarkShadow backup (it has " + n + ")")
        good.append(m)
    return good


def restore(path, before=True, out=True):
    path = os.path.abspath(os.path.expanduser(path))
    if not os.path.isfile(path) or os.path.getsize(path) > MAX_RESTORE:
        sys.exit("rice-backup: not a backup file: " + path)
    meta = read_meta(path)
    if not meta or meta.get("app") != "DarkShadow's Shell" or int(meta.get("format", 0)) > FORMAT:
        sys.exit("rice-backup: this is not a DarkShadow backup (or one from a newer version)")
    try:
        with tarfile.open(path, "r:gz") as t:
            members = safe_members(t)
            # what is here now is kept first, so a restore can always be undone (a profile switch, V6.55, does not
            # need it: rice-profile keeps the profile you leave)
            if before:
                keep = save(DEFAULT_DIR, True)
                os.replace(keep, os.path.join(DEFAULT_DIR, "before-restore-" + time.strftime("%Y-%m-%d-%H%M%S") + ".dsbackup"))
            walls = HOME + "/Pictures/Wallpapers"
            for m in members:
                # V6.55: the shell's own record of which version is installed (and where its repo is) stays as it is
                # here: an older backup or profile made the updater think an old version was back
                if m.name in ("home/.config/rice/version", "home/.config/rice/repo"):
                    continue
                if m.name.startswith("wallpaper/"):
                    os.makedirs(walls, exist_ok=True)
                    dest = os.path.join(walls, os.path.basename(m.name))
                else:
                    dest = os.path.join(HOME, m.name[len("home/"):])
                if m.isdir():
                    os.makedirs(dest, exist_ok=True)
                    continue
                os.makedirs(os.path.dirname(dest), exist_ok=True)
                src = t.extractfile(m)
                tmp = dest + ".restore-tmp"
                with open(tmp, "wb") as o:
                    shutil.copyfileobj(src, o)
                os.replace(tmp, dest)
    except (tarfile.TarError, ValueError) as e:
        sys.exit("rice-backup: " + str(e))
    # start again with it: Hyprland reads its files, then the wallpaper, the bar and the shell
    wall = meta.get("wallpaper", "")
    cmds = [["hyprctl", "reload"]]
    if wall and os.path.isfile(HOME + "/Pictures/Wallpapers/" + wall):
        cmds.append([BIN + "rice-walls", "set", HOME + "/Pictures/Wallpapers/" + wall])
    cmds += [[BIN + "rice-desktop", "restart"]]
    for c in cmds:
        if shutil.which(c[0]) or os.access(c[0], os.X_OK):
            subprocess.run(c, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
    if out:
        print(json.dumps({"restored": path, "made": meta.get("made", ""), "before": "before-restore" if before else ""}))


def main(a):
    cmd = a[1] if len(a) > 1 else ""
    if cmd == "save":
        save(a[2] if len(a) > 2 else "")
    elif cmd == "list":
        cmd_list(a[2] if len(a) > 2 else "")
    elif cmd == "restore" and len(a) > 2:
        restore(a[2])
    else:
        print(__doc__.strip())
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv)
