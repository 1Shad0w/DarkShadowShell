# V6.55: what a style changes beyond its own keys (Minimal mode, the notification colors, the lock screen style) goes
# back to how you had it when the next style does not set it, so leaving Brutal gives your round corners back
EXTRA_KEYS = ("minimal", "notify_colors", "lock_style")
PRESETS = DIR + "/presets.json"


def jread(path):
    try:
        return json.load(open(path))
    except Exception:
        return {}


# ---------------- your own themes ----------------
def user_themes():
    """your saved themes, checked: a broken entry is left out (key "user-...")"""
    out = {}
    for k, t in (jread(PRESETS).get("themes") or {}).items():
        if not (isinstance(k, str) and k.startswith("user-") and isinstance(t, dict)):
            continue
        base = dict(THEMES["darkshadow"])
        base.update({x: t[x] for x in base if x in t and type(t[x]) in (type(base[x]), int, float)})
        base["name"] = str(t.get("name", k[5:]))[:40]
        base["desc"] = str(t.get("desc", ""))[:120]
        base["user"] = True
        if isinstance(t.get("wallpaper"), str):
            base["wallpaper"] = t["wallpaper"]
        ex = clean_extra(t.get("extra"))
        if ex:
            base["extra"] = ex
        if isinstance(t.get("author"), str):
            base["author"] = t["author"][:40]
        out[k] = base
    return out


# ---------------- V5.03: more of the look in a theme ----------------
# What a theme saved from your desktop also keeps (each one optional; an old theme simply has none of them):
# the window animations, Minimal mode, the fonts, the cursor, the notification colors and the lock screen style.
ANIMS = ["calm", "emphasized", "expressive", "glide", "pop"]
FRAMES = ["double", "single", "thin"]
NOTIFY_COLORS = ["shell", "graphite", "black", "slate", "tinted", "white"]
LOCK_STYLES = ["cards", "glance", "classic"]


def clean_extra(e):
    """only known keys with sane values (a file from someone else is checked the same way)"""
    if not isinstance(e, dict):
        return {}
    out = {}
    if e.get("anim_style") in ANIMS:
        out["anim_style"] = e["anim_style"]
    m = e.get("minimal")
    if isinstance(m, dict) and isinstance(m.get("on"), bool):
        out["minimal"] = {"on": m["on"], "frame": m.get("frame") if m.get("frame") in FRAMES else "double"}
    f = e.get("fonts")
    if isinstance(f, dict):
        ff = {k: str(f[k])[:60] for k in ("main", "title") if isinstance(f.get(k), str) and re.match(r"^[\w .+-]{1,60}$", f[k])}
        if ff:
            out["fonts"] = ff
    c = e.get("cursor")
    if isinstance(c, dict) and isinstance(c.get("theme"), str) and re.match(r"^[\w .+-]{1,60}$", c["theme"]):
        try:
            size = max(16, min(64, int(c.get("size", 24))))
        except (TypeError, ValueError):
            size = 24
        out["cursor"] = {"theme": c["theme"], "size": size}
    if e.get("notify_colors") in NOTIFY_COLORS:
        out["notify_colors"] = e["notify_colors"]
    if e.get("lock_style") in LOCK_STYLES:
        out["lock_style"] = e["lock_style"]
    return out


def capture_extra():
    e = {}
    try:
        r = subprocess.run([BIN + "hypr-set", "state"], capture_output=True, text=True, timeout=10)
        e["anim_style"] = ((json.loads(r.stdout) or {}).get("anim") or {}).get("style")
    except Exception:
        pass
    m = jread(DIR + "/minimal.json")
    e["minimal"] = {"on": m.get("on") is True, "frame": m.get("frame", "double")}
    f = jread(DIR + "/fonts.json")
    e["fonts"] = {k: f[k] for k in ("main", "title") if isinstance(f.get(k), str)}
    c = jread(DIR + "/cursor.json")
    if c.get("theme"):
        e["cursor"] = {"theme": c["theme"], "size": c.get("size", 24)}
    e["notify_colors"] = jread(DIR + "/notify.json").get("colors", "shell")
    e["lock_style"] = jread(DIR + "/lock.json").get("style", "cards")
    return clean_extra(e)


def installed_cursors():
    try:
        r = subprocess.run([BIN + "rice-cursor", "state"], capture_output=True, text=True, timeout=20)
        return [t.get("id") for t in (json.loads(r.stdout) or {}).get("themes", [])]
    except Exception:
        return []


def apply_extra(ex):
    if ex.get("anim_style"):
        tool("hypr-set", "anim-style", ex["anim_style"])
    if "minimal" in ex:
        m = ex["minimal"]
        tool("rice-minimal", "set", "frame", m["frame"])
        tool("rice-minimal", "on" if m["on"] else "off")
    for k, fam in (ex.get("fonts") or {}).items():
        tool("font-set", "set", k, fam)                # only fonts this computer has (font-set says no otherwise)
    c = ex.get("cursor")
    if c and c["theme"] in installed_cursors():
        tool("rice-cursor", "set", c["theme"], c["size"])
    if ex.get("notify_colors"):
        tool("rice-notify", "set", "colors", ex["notify_colors"])
    if ex.get("lock_style"):
        tool("rice-lock", "set", "style", ex["lock_style"])


def current_extra(k):
    """how one of the extras is set now (to give it back later)"""
    if k == "minimal":
        m = jread(DIR + "/minimal.json")
        return {"on": m.get("on") is True, "frame": m.get("frame") if m.get("frame") in FRAMES else "double"}
    if k == "notify_colors":
        v = jread(DIR + "/notify.json").get("colors", "shell")
        return v if v in NOTIFY_COLORS else "shell"
    if k == "lock_style":
        v = jread(DIR + "/lock.json").get("style", "cards")
        return v if v in LOCK_STYLES else "cards"
    return None


def all_themes():
    t = dict(THEMES)
    t.update(user_themes())
    return t


def capture(name):
    """the theme of how things look right now"""
    p = jread(APPPREFS)
    bar = jread(DIR + "/bar.json")
    nt = jread(DIR + "/notify.json")
    dk = jread(DIR + "/desktop.json")
    hy = {}
    try:
        r = subprocess.run([BIN + "hypr-set", "state"], capture_output=True, text=True, timeout=10)
        hy = (json.loads(r.stdout) or {}).get("opts", {})
    except Exception:
        pass
    try:
        mode = open(DIR + "/color-mode").read().strip() or "auto"
    except OSError:
        mode = "auto"
    try:
        font = (jread(DIR + "/fonts.json").get("main") or UI_FONT)
    except Exception:
        font = UI_FONT
    try:
        wall = open(HOME + "/.cache/hyprquickpaper-current").read().strip()
    except OSError:
        wall = ""
    d = THEMES["darkshadow"]
    pal = palette()

    def num(v, dflt):
        try:
            return float(v)
        except (TypeError, ValueError):
            return dflt
    t = {
        "name": name, "desc": "Your own theme",
        "colors": mode, "corners": num(p.get("cornerScale"), d["corners"]), "shape": p.get("accentShape") or d["shape"],
        "wavy": p.get("wavy", d["wavy"]) is not False, "motion": p.get("motion") or d["motion"],
        "bounce": num(p.get("bounce"), d["bounce"]),
        "bar": bar.get("style") or d["bar"], "bar_opacity": num(bar.get("opacity"), d["bar_opacity"]),
        "widgets": dk.get("widgetTheme") or d["widgets"], "notify": nt.get("style") or d["notify"],
        "notify_radius": int(num(nt.get("radius"), d["notify_radius"])),
        "rounding": int(num(hy.get("decoration.rounding"), d["rounding"])), "gaps_in": int(num(hy.get("general.gaps_in"), d["gaps_in"])),
        "gaps_out": int(num(hy.get("general.gaps_out"), d["gaps_out"])), "border": int(num(hy.get("general.border_size"), d["border"])),
        "font": font,
        "preview": [pal.get("surface", "#101014"), pal.get("primary", "#c9b68a"), pal.get("on_surface", "#e8e4dc")],
    }
    if wall and os.path.isfile(wall):
        t["wallpaper"] = wall
    t["extra"] = capture_extra()
    return t


def save_user(name):
    name = name.strip()[:40]
    if not name:
        sys.exit("rice-theme save NAME")
    key = "user-" + (re.sub(r"[^\w]+", "-", name.lower()).strip("-_") or "theme")
    j = jread(PRESETS)
    th = j.get("themes") if isinstance(j.get("themes"), dict) else {}
    th[key] = capture(name)
    j["themes"] = th
    os.makedirs(DIR, exist_ok=True)
    tmp = PRESETS + ".tmp"
    json.dump(j, open(tmp, "w"), indent=1)
    os.replace(tmp, PRESETS)
    c = load()
    c["theme"] = key
    save(c)
    print(key)


def delete_user(key):
    j = jread(PRESETS)
    th = j.get("themes") if isinstance(j.get("themes"), dict) else {}
    if key in th:
        th.pop(key)
        j["themes"] = th
        tmp = PRESETS + ".tmp"
        json.dump(j, open(tmp, "w"), indent=1)
        os.replace(tmp, PRESETS)
        c = load()
        if c["theme"] == key:
            c["theme"] = "darkshadow"
            save(c)


def load():
    c = {"theme": "darkshadow", "apps": {"vscode": True, "discord": True}}
    try:
        j = json.load(open(CONF))
        c["theme"] = j.get("theme", c["theme"])
        c["apps"].update(j.get("apps") or {})
        if j.get("font_was"):
            c["font_was"] = j["font_was"]
        if isinstance(j.get("extra_was"), dict):
            c["extra_was"] = {k: v for k, v in j["extra_was"].items() if k in EXTRA_KEYS}
    except Exception:
        pass
    return c


def save(c):
    os.makedirs(DIR, exist_ok=True)
    tmp = CONF + ".tmp"
    json.dump(c, open(tmp, "w"), indent=2)
    os.replace(tmp, CONF)


def run(args, t=60):
    try:
        return subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=t).returncode == 0
    except Exception:
        return False


def tool(name, *args, t=60):
    p = BIN + name
    if os.access(p, os.X_OK):
        return run([p] + [str(a) for a in args], t)
    return False


# ---------------- the palette ----------------
def hexok(v):
    return isinstance(v, str) and re.match(r"^#[0-9a-fA-F]{6}$", v) is not None


def mix(a, b, t):
    a, b = a.lstrip("#"), b.lstrip("#")
    return "#" + "".join("%02x" % round(int(a[i:i + 2], 16) * (1 - t) + int(b[i:i + 2], 16) * t) for i in (0, 2, 4))


def palette():
    """the colors matugen made (palette.json); without it: kitty's theme and the bar's accent"""
    try:
        p = json.load(open(PALETTE))
        if all(hexok(p.get(k)) for k in ("surface", "on_surface", "primary")):
            return p
    except Exception:
        pass
    k = {}
    try:
        for line in open(HOME + "/.config/kitty/current-theme.conf"):
            m = re.match(r"^\s*(\w+)\s+(#[0-9a-fA-F]{6})", line)
            if m:
                k[m.group(1)] = m.group(2)
    except OSError:
        pass
    acc = k.get("selection_background") or "#9ec9bd"
    try:
        m = re.search(r"@define-color accent (#[0-9a-fA-F]{6})", open(HOME + "/.config/waybar/colors.css").read())
        if m and "selection_background" not in k:
            acc = m.group(1)
    except OSError:
        pass
    bg, fg = k.get("background", "#121214"), k.get("foreground", "#e6e1e5")
    return {"surface": bg, "surface_low": mix(bg, fg, 0.03), "surface_container": mix(bg, fg, 0.06),
            "surface_high": mix(bg, fg, 0.10), "surface_highest": mix(bg, fg, 0.15), "on_surface": fg,
            "on_surface_variant": mix(fg, bg, 0.3), "outline": k.get("color8", mix(fg, bg, 0.55)),
            "outline_variant": mix(fg, bg, 0.75), "primary": acc, "on_primary": k.get("selection_foreground", bg),
            "primary_container": mix(acc, bg, 0.6), "on_primary_container": mix(acc, fg, 0.7),
            "secondary": k.get("color4", acc), "secondary_container": mix(acc, bg, 0.75),
            "tertiary": k.get("color2", acc), "error": k.get("color1", "#ffb4ab")}


# ---------------- VSCodium / VS Code ----------------
def vscode_files():
    out = []
    for d in ("VSCodium", "Code", "Code - OSS", "Code - Insiders", "Cursor"):
        if os.path.isdir(XDG + "/" + d):
            out.append(XDG + "/" + d + "/User/settings.json")
    for app, d in (("com.vscodium.codium", "VSCodium"), ("com.visualstudio.code", "Code")):
        base = FLAT + "/" + app + "/config/" + d
        if os.path.isdir(base):
            out.append(base + "/User/settings.json")
    return out


def jsonc(text):
    """JSON with comments and trailing commas (VS Code's settings.json) -> dict"""
    out, i, n, s = [], 0, len(text), False
    while i < n:
        ch = text[i]
        if s:
            out.append(ch)
            if ch == "\\" and i + 1 < n:
                out.append(text[i + 1])
                i += 2
                continue
            if ch == '"':
                s = False
            i += 1
            continue
        if ch == '"':
            s = True
            out.append(ch)
            i += 1
        elif text.startswith("//", i):
            j = text.find("\n", i)
            i = n if j < 0 else j
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2)
            i = n if j < 0 else j + 2
        else:
            out.append(ch)
            i += 1
    clean = re.sub(r",(\s*[}\]])", r"\1", "".join(out))
    return json.loads(clean) if clean.strip() else {}


def vscode_colors(p):
    bg, bg2, bg3, bg4 = p["surface"], p.get("surface_container", p["surface"]), p.get("surface_high", p["surface"]), p.get("surface_highest", p["surface"])
    fg, dim, acc, onacc = p["on_surface"], p.get("on_surface_variant", p["on_surface"]), p["primary"], p.get("on_primary", p["surface"])
    accc, onaccc = p.get("primary_container", acc), p.get("on_primary_container", fg)
    line, err = p.get("outline_variant", bg4), p.get("error", "#ffb4ab")
    return {
        "editor.background": bg, "editor.foreground": fg, "editorCursor.foreground": acc,
        "editorLineNumber.foreground": p.get("outline", dim), "editorLineNumber.activeForeground": acc,
        "editor.selectionBackground": acc + "44", "editor.lineHighlightBackground": bg3 + "88",
        "editor.findMatchBackground": acc + "66", "editorIndentGuide.background1": line + "88",
        "editorWidget.background": bg2, "editorGroupHeader.tabsBackground": bg2, "editorGroup.border": line,
        "sideBar.background": bg2, "sideBar.foreground": dim, "sideBarSectionHeader.background": bg2,
        "sideBarTitle.foreground": fg, "sideBar.border": bg2,
        "activityBar.background": bg2, "activityBar.foreground": acc, "activityBar.inactiveForeground": dim,
        "activityBar.border": bg2, "activityBarBadge.background": acc, "activityBarBadge.foreground": onacc,
        "titleBar.activeBackground": bg2, "titleBar.activeForeground": fg, "titleBar.inactiveBackground": bg2,
        "titleBar.inactiveForeground": dim, "titleBar.border": bg2,
        "statusBar.background": bg2, "statusBar.foreground": dim, "statusBar.border": bg2,
        "statusBarItem.remoteBackground": acc, "statusBarItem.remoteForeground": onacc,
        "statusBar.debuggingBackground": err, "statusBar.noFolderBackground": bg2,
        "tab.activeBackground": bg, "tab.inactiveBackground": bg2, "tab.activeForeground": fg,
        "tab.inactiveForeground": dim, "tab.activeBorderTop": acc, "tab.border": bg2,
        "panel.background": bg2, "panel.border": line, "panelTitle.activeBorder": acc, "panelTitle.activeForeground": fg,
        "terminal.background": bg2, "terminal.foreground": fg, "terminalCursor.foreground": acc,
        "button.background": acc, "button.foreground": onacc, "button.hoverBackground": accc,
        "focusBorder": acc + "aa", "textLink.foreground": acc, "progressBar.background": acc,
        "badge.background": acc, "badge.foreground": onacc,
        "list.activeSelectionBackground": accc, "list.activeSelectionForeground": onaccc,
        "list.inactiveSelectionBackground": bg3, "list.hoverBackground": bg3, "list.focusOutline": acc + "88",
        "input.background": bg3, "input.foreground": fg, "input.border": line, "dropdown.background": bg3,
        "quickInput.background": bg2, "quickInputList.focusBackground": accc, "menu.background": bg2,
        "menu.foreground": fg, "menu.selectionBackground": accc, "menu.selectionForeground": onaccc,
        "scrollbarSlider.background": line + "66", "scrollbarSlider.hoverBackground": line + "aa",
        "notifications.background": bg3, "editorSuggestWidget.background": bg2,
        "editorSuggestWidget.selectedBackground": accc, "breadcrumb.background": bg,
    }


def vscode(on, p):
    done, failed = [], []
    for f in vscode_files():
        try:
            text = open(f).read() if os.path.isfile(f) else "{}"
            j = jsonc(text)
        except Exception:
            failed.append(f)
            continue
        if not isinstance(j, dict):
            failed.append(f)
            continue
        cc = j.get("workbench.colorCustomizations")
        cc = dict(cc) if isinstance(cc, dict) else {}
        ours = j.get("darkshadow.colorKeys") or []
        saved = j.get("darkshadow.yourColors") or {}
        for k in ours:            # what we set last time goes first (your own colors stay)
            cc.pop(k, None)
        if on:
            new = vscode_colors(p)
            # colors you had set yourself: kept aside, and given back when this is turned off
            for k in new:
                if k in cc:
                    saved[k] = cc[k]
            cc.update(new)
            j["darkshadow.colorKeys"] = sorted(new)
            if saved:
                j["darkshadow.yourColors"] = saved
        else:
            cc.update(saved)
            j.pop("darkshadow.colorKeys", None)
            j.pop("darkshadow.yourColors", None)
        if cc:
            j["workbench.colorCustomizations"] = cc
        else:
            j.pop("workbench.colorCustomizations", None)
        os.makedirs(os.path.dirname(f), exist_ok=True)
        bak = f + ".before-darkshadow"
        if os.path.isfile(f) and not os.path.exists(bak) and ("//" in text or "/*" in text):
            shutil.copy(f, bak)   # it had comments: your file as it was stays next to it
        tmp = f + ".tmp"
        json.dump(j, open(tmp, "w"), indent=4)
        os.replace(tmp, f)
        done.append(f)
    return done, failed


# ---------------- Discord ----------------
CSS_NAME = "darkshadow.theme.css"


def discord_dirs():
    """[(themes folder, settings.json of the client or None, kind)]"""
    out = []
    for d, kind in (("Vencord", "vencord"), ("vesktop", "vencord"), ("Equicord", "vencord"), ("equibop", "vencord"),
                    ("BetterDiscord", "bd")):
        for base in (XDG + "/" + d, FLAT + "/dev.vencord.Vesktop/config/" + d):
            if os.path.isdir(base):
                if kind == "vencord":
                    out.append((base + "/themes", base + "/settings/settings.json", kind))
                else:
                    out.append((base + "/themes", base + "/data/stable/themes.json", kind))
    return out


def discord_css(p):
    bg, bg2, bg3, bg4 = p["surface"], p.get("surface_container", p["surface"]), p.get("surface_high", p["surface"]), p.get("surface_highest", p["surface"])
    low = p.get("surface_low", bg)
    fg, dim, acc, onacc = p["on_surface"], p.get("on_surface_variant", p["on_surface"]), p["primary"], p.get("on_primary", p["surface"])
    line = p.get("outline_variant", bg4)
    v = {
        # the newer Discord (visual refresh)
        "--background-base-lowest": low, "--background-base-lower": bg, "--background-base-low": bg2,
        "--background-surface-high": bg3, "--background-surface-higher": bg4, "--background-surface-highest": bg4,
        "--chat-background-default": bg, "--bg-base-primary": bg, "--bg-base-secondary": bg2, "--bg-base-tertiary": low,
        "--text-default": fg, "--text-strong": fg, "--text-subtle": dim, "--text-link": acc,
        "--border-subtle": line, "--border-normal": line,
        # the older names (some clients and themes still use them)
        "--background-primary": bg, "--background-secondary": bg2, "--background-secondary-alt": bg3,
        "--background-tertiary": low, "--background-floating": bg3, "--background-nested-floating": bg3,
        "--background-accent": acc, "--background-modifier-hover": bg3 + "99",
        "--background-modifier-active": bg4 + "aa", "--background-modifier-selected": bg4 + "cc",
        "--channeltextarea-background": bg3, "--modal-background": bg2, "--modal-footer-background": bg2,
        "--input-background": bg3, "--deprecated-card-bg": bg2, "--home-background": bg, "--bg-overlay-chat": bg,
        "--text-normal": fg, "--text-muted": dim, "--header-primary": fg, "--header-secondary": dim,
        "--channels-default": dim, "--interactive-normal": dim, "--interactive-hover": fg,
        "--interactive-active": fg, "--interactive-muted": line,
        "--brand-500": acc, "--brand-560": acc, "--brand-experiment": acc, "--brand-experiment-560": acc,
        "--button-filled-brand-background": acc, "--button-filled-brand-text": onacc,
        "--scrollbar-auto-thumb": line, "--scrollbar-thin-thumb": line,
    }
    body = "\n".join("    %s: %s !important;" % kv for kv in v.items())
    return ("/**\n * @name DarkShadow\n * @author DarkShadow's Shell\n * @description Your desktop's colors "
            "(made by rice-theme; it changes with your wallpaper)\n * @version 1.0.0\n */\n\n"
            ":root, .theme-dark, .theme-darker, .theme-midnight, .visual-refresh.theme-dark {\n" + body + "\n}\n"
            "::selection { background: %s66; }\n" % acc)


def discord(on, p):
    done = []
    css = discord_css(p)
    for themes, settings, kind in discord_dirs():
        f = themes + "/" + CSS_NAME
        try:
            if on:
                os.makedirs(themes, exist_ok=True)
                open(f, "w").write(css)
            elif os.path.exists(f):
                os.remove(f)
        except OSError:
            continue
        # turned on (or off) in the client
        try:
            j = json.load(open(settings)) if os.path.isfile(settings) else None
        except Exception:
            j = None
        if isinstance(j, dict):
            if kind == "vencord":
                l = [x for x in (j.get("enabledThemes") or []) if x != CSS_NAME]
                if on:
                    l.append(CSS_NAME)
                j["enabledThemes"] = l
            else:
                j["DarkShadow"] = on
            try:
                os.makedirs(os.path.dirname(settings), exist_ok=True)
                tmp = settings + ".tmp"
                json.dump(j, open(tmp, "w"), indent=4)
                os.replace(tmp, settings)
            except OSError:
                pass
        done.append(themes)
    return done


# ---------------- the theme ----------------
def set_prefs(kv):
    os.makedirs(DIR, exist_ok=True)
    lk = open(APPPREFS + ".lock", "w")      # the same lock Settings uses (Prefs.qml): one read-write at a time
    fcntl.flock(lk, fcntl.LOCK_EX)
    try:
        d = json.load(open(APPPREFS))
    except Exception:
        d = {}
    d.update(kv)
    tmp = APPPREFS + ".tmp"
    json.dump(d, open(tmp, "w"))
    os.replace(tmp, APPPREFS)


def apply(key):
    t = all_themes()[key]
    c = load()
    c["theme"] = key
    save(c)
    # Settings and the desktop shell (they read settings-app.json)
    set_prefs({"cornerScale": t["corners"], "accentShape": t["shape"], "wavy": t["wavy"], "motion": t["motion"],
               "bounce": t["bounce"]})
    tool("desktop-set", "widgets-theme", t["widgets"])
    tool("rice-bar", "set", "style", t["bar"])
    tool("rice-bar", "set", "opacity", t["bar_opacity"])
    tool("rice-notify", "set", "style", t["notify"])
    tool("rice-notify", "set", "radius", t["notify_radius"])
    # windows (Hyprland; niri reads the same values from rice-niri)
    tool("hypr-set", "set", "decoration.rounding", t["rounding"])
    tool("hypr-set", "set", "general.gaps_in", t["gaps_in"])
    tool("hypr-set", "set", "general.gaps_out", t["gaps_out"])
    tool("hypr-set", "set", "general.border_size", t["border"])
    if os.environ.get("NIRI_SOCKET"):
        tool("rice-niri", "apply")
    # the font: only the monospace theme changes it (and gives yours back when you leave it)
    if t["font"] == MONO_FONT and not c.get("font_was"):
        try:
            f = json.load(open(DIR + "/fonts.json"))
        except Exception:
            f = {}
        c["font_was"] = {"main": f.get("main") or UI_FONT, "title": f.get("title") or UI_FONT}
        tool("font-set", "set", "main", MONO_FONT)
        tool("font-set", "set", "title", MONO_FONT)
    elif t["font"] != MONO_FONT and c.get("font_was"):
        tool("font-set", "set", "main", c["font_was"]["main"])
        tool("font-set", "set", "title", c["font_was"]["title"])
        c.pop("font_was")
    # the extras this style sets: keep how they were (the first time), give them back when a style leaves them out
    ex = t.get("extra") or {}
    was = c.get("extra_was") if isinstance(c.get("extra_was"), dict) else {}
    back = {}
    for k in EXTRA_KEYS:
        if k in ex and k not in was:
            was[k] = current_extra(k)
        elif k not in ex and k in was:
            if was[k] is not None:
                back[k] = was[k]
            was.pop(k)
    c["extra_was"] = was
    save(c)
    if back:
        apply_extra(back)
    if ex:
        apply_extra(ex)
    # the colors last: the wallpaper's colors are made again, and the apps follow (sync)
    # your own theme: its wallpaper too (that makes the colors as well)
    w = t.get("wallpaper", "")
    if t.get("user") and w and os.path.isfile(w):
        hp = HOME + "/.config/quickshell/hyprquickpaper/commands.sh"
        # the color mode first without making colors (the wallpaper below makes them, once)
        try:
            open(DIR + "/color-mode", "w").write(t["colors"] + "\n")
        except OSError:
            pass
        if os.access(hp, os.X_OK):
            run([hp, w], 180)
        else:
            tool("rice-walls", "set", w, t=180)
        sync()
        wave(key)
        return
    tool("rice-colors", "mode", t["colors"], t=180)
    sync()
    wave(key)


def wave(key):
    """V6.55: the desktop shows the new style coming in (ThemeWave.qml)"""
    try:
        os.makedirs(HOME + "/.cache/rice", exist_ok=True)
        with open(HOME + "/.cache/rice/theme-wave", "w") as f:
            f.write("%.3f %s\n" % (time.time(), key))
    except OSError:
        pass


def sync():
    c = load()
    p = palette()
    a = c["apps"]
    v, bad = vscode(a.get("vscode", True), p) if vscode_files() else ([], [])
    d = discord(a.get("discord", True), p) if discord_dirs() else []
    return v, bad, d


def state():
    c = load()
    print(json.dumps({"theme": c["theme"], "apps": c["apps"],
                      "found": {"vscode": [os.path.dirname(os.path.dirname(f)).replace(HOME, "~") for f in vscode_files()],
                                "discord": [os.path.dirname(t).replace(HOME, "~") for t, _, _ in discord_dirs()]},
                      "palette": palette()}))


# ---------------- V5.03: sharing themes ----------------
SHARE_DIR = HOME + "/DarkShadow-themes"
WALLS = HOME + "/.local/share/rice/theme-walls"
PIC_EXT = (".jpg", ".jpeg", ".png", ".webp")
MAX_FILE = 60 * 1024 * 1024
REPO_RAW = "https://raw.githubusercontent.com/shadowww-dev/DarkShadowShell/main/"


def slug(name):
    return re.sub(r"[^\w]+", "-", str(name).lower()).strip("-_")[:40] or "theme"


def picture_ok(data):
    return data[:3] == b"\xff\xd8\xff" or data[:8] == b"\x89PNG\r\n\x1a\n" or (data[:4] == b"RIFF" and data[8:12] == b"WEBP")


def export(key, out_dir=SHARE_DIR):
    th = all_themes()
    if key not in th:
        sys.exit("no theme " + key)
    t = dict(th[key])
    if not t.get("user"):
        t["extra"] = t.get("extra") or {}
    wall = t.pop("wallpaper", "")
    for k in ("user", "key", "preview_img"):
        t.pop(k, None)
    os.makedirs(out_dir, exist_ok=True)
    f = os.path.join(out_dir, slug(t.get("name", key)) + ".dstheme")
    doc = {"format": 1, "app": "DarkShadow's Shell", "theme": t}
    with zipfile.ZipFile(f + ".tmp", "w", zipfile.ZIP_DEFLATED) as z:
        if wall and os.path.isfile(wall) and os.path.splitext(wall)[1].lower() in PIC_EXT and os.path.getsize(wall) < MAX_FILE:
            name = "wallpaper" + os.path.splitext(wall)[1].lower()
            z.write(wall, name)
            doc["wallpaper"] = name
        z.writestr("theme.json", json.dumps(doc, indent=1))
    os.replace(f + ".tmp", f)
    print(f)


def store(t, wall_bytes=None, wall_ext=".jpg", wall_path=""):
    """keep a theme from a file as one of your own (a new key when the name is taken); returns its key"""
    name = str(t.get("name") or "Imported")[:40]
    j = jread(PRESETS)
    th = j.get("themes") if isinstance(j.get("themes"), dict) else {}
    key = "user-" + slug(name)
    n = 2
    while key in th:
        key = "user-%s-%d" % (slug(name), n)
        n += 1
    base = THEMES["darkshadow"]
    keep = {x: t[x] for x in base if x in t and type(t[x]) in (type(base[x]), int, float)}
    if not (isinstance(keep.get("preview"), list) and len(keep["preview"]) == 3 and all(hexok(c) for c in keep["preview"])):
        keep["preview"] = list(base["preview"])
    if keep.get("colors") not in all_scheme_keys():
        keep["colors"] = "auto"
    keep["name"] = name
    keep["desc"] = str(t.get("desc") or "Imported theme")[:120]
    if isinstance(t.get("author"), str):
        keep["author"] = t["author"][:40]
    ex = clean_extra(t.get("extra"))
    if ex:
        keep["extra"] = ex
    if wall_bytes:
        os.makedirs(WALLS, exist_ok=True)
        wp = os.path.join(WALLS, key + wall_ext)
        open(wp, "wb").write(wall_bytes)
        keep["wallpaper"] = wp
    elif wall_path and os.path.isfile(wall_path):
        keep["wallpaper"] = wall_path
    th[key] = keep
    j["themes"] = th
    os.makedirs(DIR, exist_ok=True)
    json.dump(j, open(PRESETS + ".tmp", "w"), indent=1)
    os.replace(PRESETS + ".tmp", PRESETS)
    return key


def all_scheme_keys():
    try:
        r = subprocess.run([BIN + "rice-colors", "list"], capture_output=True, text=True, timeout=10)
        j = json.loads(r.stdout)
        return [x.get("key") for x in (j if isinstance(j, list) else j.get("schemes", []))] or ["auto"]
    except Exception:
        return ["auto", "grey", "mono", "ink", "steel", "ember", "orchid"]


def repo_wallpaper(name):
    """a wallpaper of the repo by its name: the copy the installer put in your Wallpapers folder, else downloaded"""
    if not re.match(r"^[\w.-]{1,80}\.(jpg|jpeg|png|webp)$", name or ""):
        return ""
    try:
        pics = subprocess.run(["xdg-user-dir", "PICTURES"], capture_output=True, text=True, timeout=3).stdout.strip()
    except Exception:
        pics = ""
    d = (pics if pics and pics != HOME else HOME + "/Pictures") + "/Wallpapers"
    f = os.path.join(d, name)
    if os.path.isfile(f):
        return f
    data = fetch(REPO_RAW + "wallpapers/" + name)
    if data and picture_ok(data):
        os.makedirs(d, exist_ok=True)
        open(f, "wb").write(data)
        return f
    return ""


def import_file(path):
    path = os.path.expanduser(path.strip())
    if not os.path.isfile(path) or os.path.getsize(path) > MAX_FILE:
        sys.exit("Not a theme file: " + path)
    wall, ext, wpath = None, ".jpg", ""
    if path.lower().endswith(".json"):
        try:
            doc = json.load(open(path))
        except Exception:
            sys.exit("Not a theme file (the JSON could not be read)")
    else:
        try:
            z = zipfile.ZipFile(path)
        except zipfile.BadZipFile:
            sys.exit("Not a theme file (not a .dstheme)")
        with z:
            names = z.namelist()
            if "theme.json" not in names or sum(i.file_size for i in z.infolist()) > MAX_FILE:
                sys.exit("Not a theme file (theme.json is missing)")
            try:
                doc = json.loads(z.read("theme.json").decode("utf-8"))
            except Exception:
                sys.exit("Not a theme file (theme.json could not be read)")
            wn = doc.get("wallpaper") if isinstance(doc, dict) else None
            if isinstance(wn, str) and wn in names and re.match(r"^wallpaper\.(jpg|jpeg|png|webp)$", wn):
                data = z.read(wn)
                if picture_ok(data):
                    wall, ext = data, os.path.splitext(wn)[1]
    if not isinstance(doc, dict) or not isinstance(doc.get("theme"), dict):
        sys.exit("Not a theme file (no theme in it)")
    if not wall and isinstance(doc.get("repo_wallpaper"), str):
        wpath = repo_wallpaper(doc["repo_wallpaper"])
    key = store(doc["theme"], wall, ext, wpath)
    print(key)
    return key


def theme_files():
    out = []
    for d in (HOME + "/Downloads", SHARE_DIR, HOME):
        try:
            for n in sorted(os.listdir(d)):
                f = os.path.join(d, n)
                if n.lower().endswith(".dstheme") and os.path.isfile(f):
                    out.append({"name": n[:-8], "path": f, "where": d.replace(HOME, "~"), "time": int(os.path.getmtime(f))})
        except OSError:
            pass
    out.sort(key=lambda x: -x["time"])
    print(json.dumps(out[:30]))


def fetch(url, limit=MAX_FILE):
    if not url.startswith(REPO_RAW):
        return None
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "DarkShadowShell"})
        with urllib.request.urlopen(req, timeout=15) as r:
            data = r.read(limit + 1)
        return data if len(data) <= limit else None
    except Exception:
        return None


def main(a):
    # matugen starts a sync per wallpaper change: one at a time, so two cannot overwrite each other's read
    os.makedirs(DIR, exist_ok=True)
    lk = open(DIR + "/.theme.lock", "w")
    fcntl.flock(lk, fcntl.LOCK_EX)
    cmd = a[1] if len(a) > 1 else ""
    arg = a[2] if len(a) > 2 else ""
    if cmd == "list":
        u = user_themes()
        print(json.dumps({"current": load()["theme"],
                          "themes": [dict(THEMES[k], key=k) for k in ORDER] + [dict(u[k], key=k) for k in sorted(u)]}))
    elif cmd == "state":
        state()
    elif cmd == "apply" and arg in all_themes():
        apply(arg)
    elif cmd == "save" and arg:
        save_user(" ".join(a[2:]))
    elif cmd == "delete" and arg.startswith("user-"):
        delete_user(arg)
    elif cmd == "app" and arg in ("vscode", "discord") and len(a) > 3 and a[3] in ("on", "off"):
        c = load()
        c["apps"][arg] = a[3] == "on"
        save(c)
        p = palette()
        if arg == "vscode":
            done, bad = vscode(c["apps"][arg], p)
            if bad:
                sys.exit("rice-theme: could not read " + ", ".join(bad))
        else:
            discord(c["apps"][arg], p)
    elif cmd == "export" and arg:
        export(arg, a[3] if len(a) > 3 else SHARE_DIR)
    elif cmd == "import" and arg:
        import_file(" ".join(a[2:]))
    elif cmd == "files":
        theme_files()
    elif cmd == "sync":
        v, bad, d = sync()
        print("VSCodium / VS Code: %d, Discord: %d%s" % (len(v), len(d), (" (could not read: " + ", ".join(bad) + ")") if bad else ""))
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv)
