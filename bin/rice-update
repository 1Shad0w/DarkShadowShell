#!/usr/bin/env python3
"""rice-update: updates for DarkShadow's Shell.

  rice-update               install the newest version (runs ./install.sh --update in the repo)
  rice-update check [--json] [--offline]
                            compare your version with the newest one on GitHub
  rice-update watch [on|off|state]  background: checks after login and once a day, shows a notification; off: no checks
                            (how often: every_minutes in ~/.config/rice/update.json, 60 - 10080)
  rice-update notify        show the "Update is Available!" notification now (to try it)
  rice-update update        the one update both Settings > Update Center and the About tab run: the shell, and the
                            system's packages (Arch, Fedora, Gentoo, Flatpak, Snap ...) in a terminal when any
                            wait (the password belongs there). AUR is not updated here: install.sh upgrades only
                            what the shell needs
  rice-update gui           update in the background for Settings > Update Center (no terminal): the steps go to
                            ~/.cache/rice/update-live.log, the state to ~/.cache/rice/update-live.json
  rice-update whatsnew [VERSION]   JSON: what is new in this version (or VERSION), from the CHANGELOG
                            ("show": true the first time Settings opens after an update)
  rice-update whatsnew-seen        Settings showed it: not again for this version
"""
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request

HOME = os.path.expanduser("~")
DIR = HOME + "/.config/rice"
INSTALLED = DIR + "/version"
INSTALLED_REV = DIR + "/version-revision"
CACHE = HOME + "/.cache/rice"
STATE = CACHE + "/update.json"
RELEASES = CACHE + "/published-releases.json"
NOTIFIED = CACHE + "/update-notified"
LIVE_LOG = CACHE + "/update-live.log"
LIVE = CACHE + "/update-live.json"
FIRST_WAIT = 45            # seconds after login
UPDATE_CFG = DIR + "/update.json"
DEFAULTS = {"watch": True, "every_minutes": 1440, "channel": "stable"}
TICK = 30                  # a check from the About tab of the dashboard is noticed within this many seconds
APP = "DarkShadow's Shell"
ICON = HOME + "/.local/share/rice/icon.png"


def cfg():
    """background checks: on by default (a security fix has to reach people), once a day, and the user decides"""
    c = dict(DEFAULTS)
    try:
        raw = json.load(open(UPDATE_CFG))
        if isinstance(raw, dict):
            c.update({k: raw[k] for k in DEFAULTS if k in raw})
        c["every_minutes"] = max(60, min(10080, int(c["every_minutes"])))
    except Exception:
        pass
    c["channel"] = "dev" if c.get("channel") == "dev" else "stable"
    return c


def channel():
    return cfg().get("channel", "stable")


def branch():
    return "dev" if channel() == "dev" else "main"


def save_cfg(c):
    os.makedirs(DIR, exist_ok=True)
    tmp = UPDATE_CFG + ".tmp"
    json.dump(c, open(tmp, "w"))
    os.replace(tmp, UPDATE_CFG)


def repo():
    try:
        r = open(DIR + "/repo").read().strip()
        if r and os.path.exists(r + "/install.sh"):
            return r
    except OSError:
        pass
    r = HOME + "/shadows-shell"
    return r if os.path.exists(r + "/install.sh") else None


ZIP_MSG = ("This copy of the shell was downloaded as a ZIP (from a GitHub release), not with git, so it cannot get new "
           "versions. Run rice-update in a terminal: it turns it into a git copy and updates.")


def is_zip(r):
    """a copy without .git (the ZIP of a GitHub release): nothing to pull from, it reinstalled the same old version"""
    return bool(r) and not os.path.isdir(r + "/.git")


def make_git(r):
    """clone the project next to the ZIP copy and put the clone in its place (the ZIP copy is kept, renamed)"""
    if not shutil.which("git"):
        print("git is not installed. Install it (sudo pacman -S git, sudo apt install git ...) and run rice-update again.")
        return None
    target = HOME + "/shadows-shell"
    stamp = time.strftime("%Y%m%d-%H%M%S")
    tmp = target + ".new-" + stamp
    print("Downloading the project with git ...")
    c = subprocess.call(["git", "-c", "credential.helper=", "clone", "--quiet", NEW_URL, tmp],
                        env=dict(os.environ, GIT_TERMINAL_PROMPT="0", GCM_INTERACTIVE="never"))
    if c != 0 or not os.path.exists(tmp + "/install.sh"):
        shutil.rmtree(tmp, ignore_errors=True)
        print("git clone did not work (offline?). Nothing was changed.")
        return None
    if os.path.exists(target):
        os.rename(target, target + ".zip-" + stamp)
        print("Your old copy is kept as " + target + ".zip-" + stamp)
    os.rename(tmp, target)
    os.makedirs(DIR, exist_ok=True)
    open(DIR + "/repo", "w").write(target + "\n")
    print("Done: " + target + " is a git copy now, so updates work from here on.")
    return target


VERSION_TAG = re.compile(r"(?:dotfiles-)?v?\.?([0-9]+\.[0-9]+(?:-v?[0-9]+(?:\.[0-9]+)*|-[a-z][a-z0-9.-]*)?)", re.I)
TAG_PATTERNS = ("[vV][0-9]*", "[vV].[0-9]*", "Dotfiles-[vV][0-9]*", "[0-9]*.[0-9]*")


def clean(v):
    match = VERSION_TAG.fullmatch((v or "").strip())
    return re.sub(r"-v(?=[0-9])", "-", match.group(1).lower(), count=1) if match else ""


def key(v):
    """Keep the project's decimal base version ordering and compare numeric fork suffixes numerically."""
    base, _, suffix = clean(v).partition("-")
    major, _, minor = base.partition(".")
    suffix_key = tuple((0, int(p)) if p.isdecimal() else (1, p) for p in suffix.split("."))
    return (int(major or 0), minor.rstrip("0"), not suffix, suffix_key)


def installed_base():
    try:
        with open(INSTALLED) as f:
            return clean(f.read()) or "2.01"
    except OSError:
        return "2.01"


def installed_revision(r):
    if not r or not os.path.exists(r + "/.git"):
        return ""
    try:
        with open(INSTALLED_REV) as f:
            revision = f.read().strip()
        return revision if re.fullmatch(r"[0-9a-f]{40,64}", revision) else ""
    except OSError:
        # Older installs recorded only VERSION. Infer the label from the checkout
        # when its base version still matches the version that was installed.
        v = git(r, "show", "HEAD:VERSION", timeout=5)
        return "HEAD" if v.returncode == 0 and clean(v.stdout) == installed_base() else ""


def release_tag(r, revision):
    if not revision:
        return ""
    matches = [arg for pattern in TAG_PATTERNS for arg in ("--match", pattern)]
    result = git(r, "describe", "--tags", "--first-parent", "--abbrev=0", *matches, revision, timeout=5)
    tag = result.stdout.strip()
    return tag if result.returncode == 0 and clean(tag) else ""


def installed(r=None, revision=None):
    base = installed_base()
    try:
        r = r or repo()
        if r:
            tag = release_tag(r, installed_revision(r) if revision is None else revision)
            if tag:
                return clean(tag)
    except (OSError, subprocess.SubprocessError):
        pass
    return base


def git(r, *a, timeout=25):
    # never a login window: no prompt, and no credential helper (a helper like Git Credential Manager opened a GitHub
    # sign-in window during updates; the shell is public, reading it needs no login)
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_ASKPASS="true", SSH_ASKPASS="true", GCM_INTERACTIVE="never")
    return subprocess.run(["git", "-c", "credential.helper=", "-C", r] + list(a), capture_output=True, text=True,
                          timeout=timeout, env=env)


NEW_URL = "https://github.com/shadowww-dev/DarkShadowShell.git"


# the installer's rule (install/lib/secure.sh update_remote_ok): an update may only come from this project, or a
# fork of it, never from an address edited into the repo
REPO_ORIGIN = re.compile(r"^(https://|git@|ssh://(git@)?)(www\.)?github\.com[:/][^/]+/(DarkShadowShell|dotfiles)(\.git)?/?$")


def origin_ok(r):
    try:
        u = git(r, "remote", "get-url", "origin", timeout=5).stdout.strip()
    except Exception:
        return False
    return bool(REPO_ORIGIN.search(u))


def fix_remote(r):
    """the project moved (shadows-shell -> DarkShadowShell): an old address goes to the new one, before GitHub's
    redirect is the thing that asks for a login"""
    try:
        u = git(r, "remote", "get-url", "origin", timeout=5).stdout.strip()
        if "shadowww-dev/shadows-shell" in u:
            git(r, "remote", "set-url", "origin", NEW_URL, timeout=5)
    except Exception:
        pass


def repo_slug(r):
    """Extract 'owner/repo' from origin remote if it matches REPO_ORIGIN, else default."""
    if r and os.path.exists(r + "/.git"):
        try:
            u = git(r, "remote", "get-url", "origin", timeout=5).stdout.strip()
            m = re.search(r"github\.com[:/]([^/]+/(?:DarkShadowShell|dotfiles))(?:\.git)?/?$", u)
            if m:
                return m.group(1)
        except Exception:
            pass
    return "1Shad0w/DarkShadowShell"


def published_releases(r, offline=False):
    slug = repo_slug(r)
    if offline:
        try:
            with open(RELEASES) as f:
                cached = json.load(f)
            return (cached["items"] if cached["repo"] == slug else []), ""
        except (OSError, ValueError, KeyError, TypeError):
            return [], ""
    items = []
    page = 1
    try:
        while True:
            url = "https://api.github.com/repos/%s/releases?per_page=100&page=%d" % (slug, page)
            req = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json", "User-Agent": "rice-update"})
            with urllib.request.urlopen(req, timeout=6) as response:
                releases = json.load(response)
                if not isinstance(releases, list):
                    raise ValueError("unexpected GitHub release response")
                for rel in releases:
                    if (not isinstance(rel, dict) or rel.get("draft") or not isinstance(rel.get("published_at"), str)
                            or not isinstance(rel.get("tag_name"), str) or not clean(rel["tag_name"])):
                        continue
                    items.append({"tag_name": rel["tag_name"], "published_at": rel["published_at"],
                                  "prerelease": bool(rel.get("prerelease")), "body": rel.get("body") or ""})
                if 'rel="next"' not in response.headers.get("Link", ""):
                    break
                page += 1
    except (OSError, ValueError, TypeError) as e:
        return published_releases(r, offline=True)[0], str(e)
    os.makedirs(CACHE, exist_ok=True)
    try:
        with open(RELEASES, "w") as f:
            json.dump({"repo": slug, "items": items}, f)
    except OSError:
        pass
    return items, ""


def published_at(release):
    return release["published_at"], key(release["tag_name"])


def check(offline=False, r=None):
    r = r or repo()
    have = installed(r)
    selected_channel = channel()
    releases, error = published_releases(r, offline)
    eligible = [rel for rel in releases if selected_channel == "dev" or not rel.get("prerelease")]
    latest = max(eligible, key=published_at, default=None)
    installed_release = max((rel for rel in releases if clean(rel["tag_name"]) == have), key=published_at, default=None)
    target = clean(latest["tag_name"]) if latest else have
    # Compare publications, not branch tips or the upstream VERSION fallback.
    update = bool(latest and target != have and
                  (installed_release is None or published_at(latest) > published_at(installed_release)))
    notes = [line.strip()[2:].strip() for line in ((latest or {}).get("body") or "").splitlines()
             if line.strip().startswith(("- ", "* "))]
    out = {"installed": have, "latest": target, "update": update, "changes": 0, "commit": "",
           "channel": selected_channel, "branch": branch(), "release": target if latest else "",
           "tag": latest["tag_name"] if latest else "", "news": notes[:4] if update or target == have else [],
           "checked": int(time.time()), "error": error}
    if is_zip(r) and update:
        out["error"] = ZIP_MSG
    os.makedirs(CACHE, exist_ok=True)
    try:
        with open(STATE, "w") as state:
            json.dump(out, state)
    except OSError:
        pass
    return out


def release_target(r):
    st = check(r=r)
    if st["error"] and st["error"] != ZIP_MSG:
        raise OSError(st["error"])
    return st["tag"] if st["update"] else ""


def terminal_update(tag=""):
    """ONE terminal with rice-update in it (at most one a minute), without the background update's settings: an old
    installer (before V4.56) that saw RICE_GUI in its terminal opened another terminal instead of asking, endlessly"""
    mark = CACHE + "/update-terminal"
    try:
        if time.time() - os.path.getmtime(mark) < 60:
            return
    except OSError:
        pass
    os.makedirs(CACHE, exist_ok=True)
    open(mark, "w").write(str(int(time.time())))
    env = dict(os.environ)
    for k in ("RICE_GUI", "NO_COLOR", "GIT_TERMINAL_PROMPT", "GCM_INTERACTIVE"):
        env.pop(k, None)
    env.pop("RICE_UPDATE_TAG", None)
    if tag:
        env["RICE_UPDATE_TAG"] = tag
    t = os.environ.get("TERMINAL") or "kitty"
    if not shutil.which(t):
        t = next((x for x in ("kitty", "foot", "alacritty", "wezterm", "konsole", "gnome-terminal") if shutil.which(x)), t)
    cmd = [t, "-e", HOME + "/.local/bin/rice-update"]
    if os.access(HOME + "/.local/bin/rice-term", os.X_OK):        # your terminal (Settings > Look & Feel)
        cmd = [HOME + "/.local/bin/rice-term", "-e", HOME + "/.local/bin/rice-update"]
    subprocess.Popen(cmd, start_new_session=True, env=env,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def installer_changes(r, tag):
    if not origin_ok(r):
        return False
    ref = "refs/tags/" + tag
    f = git(r, "fetch", "--quiet", "--no-tags", "origin", ref + ":" + ref, timeout=60)
    if f.returncode != 0:
        raise OSError(f.stderr.strip() or "could not fetch release tag")
    result = git(r, "diff", "--quiet", "HEAD", ref + "^{commit}", "--", "install.sh", "install", "bin")
    return result.returncode == 1


def open_center():
    """Settings > Update Center (the update runs there, with its steps shown live); a terminal without Settings"""
    rs = HOME + "/.local/bin/rice-settings"
    if os.access(rs, os.X_OK):
        subprocess.Popen([rs, "35"], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        terminal_update()


def live():
    try:
        return json.load(open(LIVE))
    except (OSError, ValueError):
        return {}


def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def ours(pid, started):
    """is PID still the update we started at STARTED? A live PID alone is not enough: after a crash the number can
    belong to something else, and the Update Center would say "already updating" for ever"""
    if not alive(pid):
        return False
    try:
        age = time.time() - float(started)
    except (TypeError, ValueError):
        age = 1e9
    if age < 0 or age > 3600:          # an update takes minutes; an hour is long dead
        return False
    try:
        with open("/proc/%d/stat" % int(pid)) as f:
            # the command has "(name)" with spaces in it: split after the last ")"
            parts = f.read().rsplit(")", 1)[-1].split()
        born = int(parts[19]) / os.sysconf("SC_CLK_TCK")
        boot = time.time() - float(open("/proc/uptime").read().split()[0])
        return abs(boot + born - float(started)) < 120        # not a reused number: the same second we started it
    except Exception:
        return True                   # no /proc (another OS): trust the age alone


def put_live(**kw):
    os.makedirs(CACHE, exist_ok=True)
    tmp = LIVE + ".new"
    with open(tmp, "w") as f:
        json.dump(kw, f)
    os.replace(tmp, LIVE)


def gui(args):
    """the update without a terminal: install.sh --update --yes --no-packages, detached from Settings (the update
    puts new Settings files in place, so Settings reloads in the middle; this keeps running and Settings reads on)"""
    os.makedirs(CACHE, exist_ok=True)
    # two clicks (Settings and the Update Center at once) started two installers: one at a time
    lk = open(CACHE + "/update.lock", "w")
    try:
        fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("already updating")
        return 0
    st = live()
    if st.get("state") == "running" and ours(st.get("pid"), st.get("started")):
        print("already updating")
        return 0
    r = repo()
    if not r:
        open(LIVE_LOG, "w").write("    \u2718 Could not find your copy of the repo (~/shadows-shell). Clone it again:\n"
                                  "      git clone https://github.com/shadowww-dev/DarkShadowShell ~/shadows-shell\n")
        put_live(state="failed", code=1, started=int(time.time()), ended=int(time.time()), pid=0)
        return 1
    if is_zip(r):
        open(LIVE_LOG, "w").write("    \u2718 " + ZIP_MSG + "\n")
        put_live(state="failed", code=1, started=int(time.time()), ended=int(time.time()), pid=0)
        terminal_update()
        return 1
    if os.fork() != 0:
        return 0
    os.setsid()
    if os.fork() != 0:
        os._exit(0)
    log = open(LIVE_LOG, "w", buffering=1)
    t0 = int(time.time())
    try:
        tag = release_target(r)
        needs_terminal = bool(tag and installer_changes(r, tag))
    except (OSError, subprocess.SubprocessError) as e:
        log.write("    ✘ %s\n" % e)
        put_live(state="failed", code=1, started=t0, ended=int(time.time()), pid=0, was=installed())
        os._exit(1)
    if not tag:
        put_live(state="done", code=0, started=t0, ended=int(time.time()), pid=0, now=installed())
        os._exit(0)
    if needs_terminal:
        log.write("    \u2139 This update changes the installer, so it is asked about in a terminal: one opened now.\n"
                  "      Answer y there (it may ask for your password). Nothing was changed yet.\n")
        put_live(state="failed", code=1, started=t0, ended=int(time.time()), pid=0, was=installed())
        fcntl.flock(lk, fcntl.LOCK_UN)
        terminal_update(tag)
        os._exit(0)
    put_live(state="running", code=-1, started=t0, ended=0, pid=os.getpid(), was=installed())
    env = dict(os.environ, RICE_UPDATE_TAG=tag, RICE_GUI="1", RICE_UPDATE_LOCK="1", NO_COLOR="1", GIT_TERMINAL_PROMPT="0", GCM_INTERACTIVE="never")
    env.pop("SUDO_ASKPASS", None)
    want = ["--update", "--yes"] + (args if args else ["--no-packages"])
    try:
        code = subprocess.call(["./install.sh"] + want, cwd=r, env=env, stdin=subprocess.DEVNULL,
                               stdout=log, stderr=subprocess.STDOUT)
    except Exception as e:
        log.write("    \u2718 %s\n" % e)
        code = 1
    try:
        check(offline=True)
    except Exception:
        pass
    put_live(state="done" if code == 0 else "failed", code=code, started=t0, ended=int(time.time()), pid=0,
             was=live().get("was", ""), now=installed())
    os._exit(0)


def packages_pending():
    """updates waiting in the system's packages, Flatpak or Snap: those need the password, so they run in a terminal.
    AUR is shown in Settings but never updated here (only the packages the shell itself needs, and install.sh does
    that). The check may take minutes (emerge, dnf): the timeout covers the slowest one."""
    b = HOME + "/.local/bin/rice-care"
    if not os.access(b, os.X_OK):
        return 0
    try:
        r = subprocess.run([b, "updates"], capture_output=True, text=True, timeout=600)
        d = json.loads((r.stdout.strip().splitlines() or ["{}"])[-1])
        if isinstance(d.get("updateable"), int):
            return d["updateable"]
        return sum(int(m.get("count") or 0) for m in d.get("managers") or [] if not m.get("manual"))
    except Exception:
        return 0


def update_all(args):
    """one action for both places that show updates: a terminal when packages wait, else the quiet GUI update"""
    if packages_pending() > 0:
        try:
            tag = release_target(repo())
        except (OSError, subprocess.SubprocessError):
            tag = ""
        if tag:
            terminal_update(tag)
            return 0
        return subprocess.call([HOME + "/.local/bin/rice-care", "update"])
    return gui(args)


def body(st):
    v = st["latest"]
    head = "<b>Update V%s</b>" % v
    if st.get("installed") and st["installed"] != v:
        head += "  ·  you have V%s" % st["installed"]
    elif st.get("changes"):
        head += "  ·  %d new change%s" % (st["changes"], "" if st["changes"] == 1 else "s")
    lines = [head]
    for n in (st.get("news") or [])[:3]:
        lines.append("•  " + n.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))
    return "\n".join(lines)


def notify(st):
    """the popup; clicking it (or Update now) opens the update in a terminal"""
    if not shutil.which("notify-send"):
        return
    icon = ICON if os.path.exists(ICON) else "system-software-update"
    try:
        r = subprocess.run(["notify-send", "-a", APP, "-i", icon, "-u", "normal", "-t", "20000",
                            "-c", "system.update",
                            "-A", "default=Update now", "-A", "update=Update now", "-A", "later=Later",
                            "--wait", "Update is Available!", body(st)],
                           capture_output=True, text=True, timeout=6 * 3600)
        if r.stdout.strip() in ("default", "update"):
            open_center()
    except Exception:
        pass


def notify_bg(st):
    if os.fork() == 0:
        os.setsid()
        notify(st)
        os._exit(0)


def maybe_notify(st):
    """show the popup once per new version / new push"""
    if not st or not st.get("update"):
        return
    try:
        told = open(NOTIFIED).read().strip()
    except OSError:
        told = ""
    tag = "%s %s" % (st.get("latest", ""), st.get("commit", ""))
    if told != tag:
        open(NOTIFIED, "w").write(tag)
        notify_bg(st)


def mtime(p):
    try:
        return os.path.getmtime(p)
    except OSError:
        return 0


def watch():
    c = cfg()
    if c.get("watch") is False:
        return
    every = int(c["every_minutes"]) * 60
    os.makedirs(CACHE, exist_ok=True)
    lk = open(CACHE + "/update-watch.lock", "w")
    try:
        fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # already running
    time.sleep(FIRST_WAIT)
    last, seen = 0.0, 0.0
    while True:
        # Settings > Language & region > Check for updates is read again every tick: off stops this one at once
        c = cfg()
        if c.get("watch") is False:
            return
        every = int(c["every_minutes"]) * 60
        try:
            if time.time() - last >= every:
                last = time.time()
                st = check()
                seen = mtime(STATE)
                maybe_notify(st)
            else:
                # the About tab of the dashboard (or rice-update check) found something: tell right away
                m = mtime(STATE)
                if m and m != seen:
                    seen = m
                    maybe_notify(json.load(open(STATE)))
        except Exception:
            pass
        time.sleep(TICK)


def run(args):
    r = repo()
    if not r:
        print("Could not find your copy of the repo. Clone it again:")
        print("  git clone https://github.com/shadowww-dev/DarkShadowShell ~/shadows-shell")
        input("Press Enter to close")
        sys.exit(1)
    if is_zip(r):
        print(ZIP_MSG.replace(" Run rice-update in a terminal: it turns", " This turns"))
        try:
            a = input("Make it a git copy now? [Y/n] ").strip().lower()
        except EOFError:
            a = "y"
        r = make_git(r) if a in ("", "y", "yes") else None
        if not r:
            try:
                input("Press Enter to close")
            except EOFError:
                pass
            sys.exit(1)
    os.chdir(r)
    env = dict(os.environ)
    for k in ("RICE_GUI", "NO_COLOR", "GIT_TERMINAL_PROMPT", "GCM_INTERACTIVE"):
        env.pop(k, None)   # a terminal the Update Center opened must ask, not act like the background update
    code = subprocess.call(["./install.sh", "--update"] + args, env=env)
    print()
    try:
        input("Press Enter to close")
    except EOFError:
        pass
    sys.exit(code)


# ---------------- V5.03: what is new ----------------
SEEN = DIR + "/whatsnew-seen"


def md_line(t):
    """a CHANGELOG line for Settings (Qt's StyledText): **bold**, `code`, the rest escaped"""
    t = t.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    t = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", t)
    return re.sub(r"`(.+?)`", r"<i>\1</i>", t)


def whatsnew(ver=None):
    r = repo()
    text = ""
    for f in ([r + "/CHANGELOG.md"] if r else []) + [HOME + "/.local/share/rice/CHANGELOG.md"]:
        try:
            text = open(f).read()
            break
        except OSError:
            pass
    inst = ""
    try:
        inst = open(INSTALLED).read().strip()
    except OSError:
        pass
    current = installed()
    ver = ver or current
    title, items, found = "", [], False
    if r and ver == current and current != clean(inst):
        releases, _ = published_releases(r, offline=True)
        release = next((rel for rel in releases if clean(rel["tag_name"]) == current), {})
        items = [md_line(line.strip()[2:].strip()) for line in (release.get("body") or "").splitlines()
                 if line.strip().startswith(("- ", "* "))]
    else:
        for line in text.splitlines():
            m = re.match(r"^##\s+V([\d.]+)\s*:?\s*(.*)$", line)
            if m:
                if found:
                    break
                found = m.group(1) == ver
                title = m.group(2).strip() if found else ""
                title = title[:1].upper() + title[1:]
                continue
            if found and line.startswith("- "):
                items.append(md_line(line[2:].strip()))
    try:
        seen = open(SEEN).read().strip()
    except OSError:
        seen = ""
    # the first install: the welcome screen shows the shell, not a changelog; it starts counting from here
    first = not os.path.exists(DIR + "/welcome-seen") and not seen
    if first and inst:
        try:
            open(SEEN, "w").write(ver + "\n")
        except OSError:
            pass
    print(json.dumps({"version": ver, "title": title, "items": items[:16], "more": max(0, len(items) - 16),
                      "show": bool(items) and not first and seen != ver and ver == current}))


def main(a):
    cmd = a[1] if len(a) > 1 else ""
    if cmd == "release-target":
        try:
            print(release_target(a[2] if len(a) > 2 else repo()))
        except (OSError, subprocess.SubprocessError) as e:
            print(e, file=sys.stderr)
            sys.exit(1)
        return
    if cmd == "whatsnew":
        whatsnew(a[2] if len(a) > 2 else None)
        return
    if cmd == "whatsnew-seen":
        try:
            open(SEEN, "w").write(installed() + "\n")
        except OSError:
            pass
        return
    if cmd == "check":
        st = check(offline="--offline" in a)
        if "--json" in a:
            print(json.dumps(st))
        elif st["update"]:
            extra = (" (%d new changes)" % st["changes"]) if st["latest"] == st["installed"] and st["changes"] else ""
            print("Update V%s is available%s (you have V%s). Run: rice-update" % (st["latest"], extra, st["installed"]))
            for n in st["news"]:
                print("  - " + n)
        else:
            print("Up to date: V%s%s" % (st["installed"], ("  (could not check: %s)" % st["error"]) if st["error"] else ""))
    elif cmd == "channel":
        if len(a) > 2 and a[2] in ("stable", "dev"):
            c = cfg()
            c["channel"] = a[2]
            save_cfg(c)
            try:
                os.remove(NOTIFIED)
            except OSError:
                pass
            print(json.dumps({"channel": c["channel"], "branch": branch()}))
        elif len(a) > 2 and a[2] in ("state", "get"):
            print(json.dumps({"channel": channel(), "branch": branch()}))
        else:
            print(channel())
    elif cmd == "watch":
        if len(a) > 2 and a[2] == "state":
            c = cfg()
            print(json.dumps({"watch": c.get("watch") is not False, "every_minutes": c["every_minutes"]}))
        elif len(a) > 2 and a[2] in ("on", "off"):
            c = cfg()
            c["watch"] = a[2] == "on"
            save_cfg(c)
            print("Background update checks: " + ("on" if c["watch"] else "off"))
            if c["watch"]:
                subprocess.Popen([sys.executable, os.path.abspath(__file__), "watch"], stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL, start_new_session=True)
        else:
            watch()
    elif cmd == "notify":
        st = check(offline="--offline" in a)
        if not st["news"]:
            st["news"] = ["This is how the update notification looks"]
        notify_bg(st)
    elif cmd == "gui":
        sys.exit(gui(a[2:]))
    elif cmd == "update":
        sys.exit(update_all(a[2:]))
    elif cmd == "center":
        open_center()
    elif cmd in ("", "run"):
        run(a[2:])
    elif cmd in ("-h", "--help", "help"):
        print(__doc__)
    else:
        run(a[1:])   # pass flags like --no-packages on to install.sh


if __name__ == "__main__":
    main(sys.argv)
