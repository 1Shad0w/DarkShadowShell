# a light wallpaper: the picture of the preset draws its desktop clock dark
PRESETS["torii"]["clock_ink"] = "#262626"
ORDER = ["shadow", "starfall", "fuji", "bluesakura", "plum", "evening", "cloudhill", "lavender", "nightsakura",
         "street", "city", "forest", "blacksand", "manga", "torii"]


def jread(p):
    try:
        return json.load(open(p))
    except Exception:
        return {}


def jwrite(p, d):
    os.makedirs(os.path.dirname(p), exist_ok=True)
    json.dump(d, open(p + ".tmp", "w"), indent=1)
    os.replace(p + ".tmp", p)


def tool(name, *args, t=60):
    p = BIN + name
    if not os.access(p, os.X_OK):
        return False
    try:
        return subprocess.run([p] + [str(a) for a in args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              timeout=t).returncode == 0
    except Exception:
        return False


def out_of(name, *args, t=20):
    try:
        return subprocess.run([BIN + name] + list(args), capture_output=True, text=True, timeout=t).stdout
    except Exception:
        return ""


def rice_theme():
    """rice-theme as a module: a preset's look goes through the same code as a theme"""
    loader = importlib.machinery.SourceFileLoader("rice_theme", BIN + "rice-theme")
    spec = importlib.util.spec_from_loader("rice_theme", loader)
    m = importlib.util.module_from_spec(spec)
    loader.exec_module(m)
    return m


def wallpaper(name):
    """the installed copy (~/Pictures/Wallpapers), else the one in the repo"""
    try:
        pics = subprocess.run(["xdg-user-dir", "PICTURES"], capture_output=True, text=True, timeout=3).stdout.strip()
    except Exception:
        pics = ""
    for d in ((pics if pics and pics != HOME else HOME + "/Pictures") + "/Wallpapers", HOME + "/Pictures/Wallpapers"):
        if os.path.isfile(os.path.join(d, name)):
            return os.path.join(d, name)
    try:
        repo = open(DIR + "/repo").read().strip()
    except OSError:
        repo = HOME + "/shadows-shell"
    f = os.path.join(repo, "wallpapers", name)
    return f if os.path.isfile(f) else ""


# ---------------- My setup: how the desktop looks before the first preset ----------------
def capture():
    rt = rice_theme()
    t = rt.capture("My setup")
    wall = t.pop("wallpaper", "")
    extra = t.pop("extra", {})
    bar = jread(DIR + "/bar.json")
    try:
        rofi = json.loads(out_of("rice-rofi", "state") or "{}")
    except ValueError:
        rofi = {}
    desk = jread(DIR + "/desktop.json")
    clk = desk.get("clock") or {}
    dk = desk.get("dock") or {}
    lk = jread(DIR + "/lock.json")
    try:
        sddm = open(DIR + "/sddm-clock").read().strip() or "classic"
    except OSError:
        sddm = "classic"
    lay = bar.get("layout")
    return {"name": "My setup", "desc": "How your desktop looked before the first preset", "wallpaper_path": wall,
            "theme": t, "extra": extra,
            "bar": {"position": bar.get("position", "top"), "autohide": bar.get("autohide", False) is True,
                    "ws_style": bar.get("ws_style", "dots"), "layout": lay if isinstance(lay, dict) else None},
            "launcher": {"layout": rofi.get("layout", "drawer"), "position": rofi.get("position", "center")},
            "clock": {"enabled": clk.get("enabled", True) is not False, "style": clk.get("style", "expressive"), "font": clk.get("font", "outfit")},
            "dock": {"enabled": dk.get("enabled", False) is True, "style": dk.get("style", "floating"), "magnify": dk.get("magnify", 0)},
            "lock": {"clock": lk.get("clock", "big"), "clock_font": lk.get("clock_font", "default"), "input": lk.get("input", "pill")},
            "sddm": sddm, "tags": []}


# ---------------- using one ----------------
def live(key, step, n, total, done=False, ok=True):
    try:
        jwrite(LIVE, {"key": key, "step": step, "n": n, "total": total, "done": done, "ok": ok, "time": time.time()})
    except OSError:
        pass


def apply(key):
    if key == "before":
        p = jread(BEFORE)
        if not p.get("theme"):
            sys.exit("My setup was not kept")
    elif key in PRESETS:
        p = PRESETS[key]
        if not os.path.exists(BEFORE):
            try:
                jwrite(BEFORE, capture())
            except Exception as e:
                sys.stderr.write("could not keep My setup: %s\n" % e)
    else:
        sys.exit("no preset " + key)
    steps = 8
    b = p.get("bar") or {}
    live(key, "The bar", 1, steps)
    if b.get("position"):
        tool("rice-bar", "set", "position", b["position"])
    tool("rice-bar", "set", "autohide", "on" if b.get("autohide") else "off")
    if b.get("ws_style"):
        tool("rice-bar", "set", "ws_style", b["ws_style"])
    if isinstance(b.get("layout"), dict):
        tool("rice-bar", "layout-set", json.dumps(b["layout"]))
    live(key, "The launcher", 2, steps)
    ln = p.get("launcher") or {}
    for k in ("layout", "position"):
        if ln.get(k):
            tool("rice-rofi", "set", k, ln[k])
    live(key, "The clock and the dock", 3, steps)
    c = p.get("clock") or {}
    tool("desktop-set", "clock", "enabled", "on" if c.get("enabled", True) else "off")
    if c.get("style"):
        tool("desktop-set", "wset", "clock", "style", c["style"])
    if c.get("font"):
        tool("desktop-set", "clock", "font", c["font"])
    d = p.get("dock") or {}
    if d.get("style"):
        tool("desktop-set", "dock", "style", d["style"])
    tool("desktop-set", "dock", "magnify", int(d.get("magnify", 0) or 0))
    tool("desktop-set", "dock", "enabled", "on" if d.get("enabled") else "off")
    live(key, "The lock and login screens", 4, steps)
    lk = p.get("lock") or {}
    for k in ("clock", "clock_font", "input"):
        if lk.get(k):
            tool("rice-lock", "set", k, lk[k])
    if p.get("sddm"):
        tool("rice-sddm", "clock", p["sddm"], t=60)
    # the look last (its colors come from the wallpaper, once): rice-theme's own code, as a theme of its own
    live(key, "Colors from the wallpaper", 5, steps)
    os.makedirs(DIR, exist_ok=True)
    lk_file = open(DIR + "/.theme.lock", "w")
    fcntl.flock(lk_file, fcntl.LOCK_EX)
    rt = rice_theme()
    th = dict(rt.THEMES["darkshadow"])
    th.update(p.get("theme") or {})
    th["name"] = p.get("name", key)
    th["desc"] = p.get("desc", "")
    th["user"] = True
    th["extra"] = rt.clean_extra(p.get("extra"))
    wall = p.get("wallpaper_path") or wallpaper(p.get("wallpaper", ""))
    if wall:
        th["wallpaper"] = wall
    tkey = "preset-" + key
    rt.THEMES[tkey] = th
    try:
        rt.apply(tkey)
    finally:
        fcntl.flock(lk_file, fcntl.LOCK_UN)
    st = jread(STATE)
    st["current"] = key
    jwrite(STATE, st)
    live(key, "Done", steps, steps, done=True)
    print(p.get("name", key))


def listing():
    st = jread(STATE)
    out = []
    for k in ORDER:
        p = dict(PRESETS[k])
        p["key"] = k
        p["wallpaper_path"] = wallpaper(p["wallpaper"])
        out.append(p)
    b = jread(BEFORE)
    print(json.dumps({"current": st.get("current", ""), "presets": out,
                      "before": {"name": "My setup", "wallpaper_path": b.get("wallpaper_path", ""),
                                 "preview": (b.get("theme") or {}).get("preview")} if b.get("theme") else None}))


def main(a):
    cmd = a[1] if len(a) > 1 else ""
    if cmd == "list":
        listing()
    elif cmd == "apply" and len(a) > 2:
        os.makedirs(DIR, exist_ok=True)
        lk = open(DIR + "/.preset.lock", "w")
        fcntl.flock(lk, fcntl.LOCK_EX)
        try:
            apply(a[2])
        except SystemExit:
            raise
        except Exception as e:
            live(a[2], "It did not work: %s" % e, 0, 8, done=True, ok=False)
            sys.exit("rice-preset: %s" % e)
    elif cmd == "forget":
        try:
            os.remove(BEFORE)
        except OSError:
            pass
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv)
