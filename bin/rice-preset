#!/usr/bin/env python3
"""rice-preset: whole-desktop presets (Settings > Appearance > Presets), V5.04.

A preset is the whole desktop at once: the wallpaper and its colors, corners and shapes, the bar (its style, its
edge, its workspaces and modules), the launcher, the desktop clock, the dock, notifications, the lock screen, the
login screen (SDDM), the window corners and gaps and how windows move. The first time one is used, how your
desktop looks is kept ("My setup"), so you can always go back.

  rice-preset list            JSON: the presets (with the wallpaper file), the one in use, and whether My setup is kept
  rice-preset apply KEY       use a preset (KEY "before": back to My setup)
  rice-preset forget          drop My setup (the next preset keeps a new one)
"""
import fcntl
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
DIR = HOME + "/.config/rice"
BIN = HOME + "/.local/bin/"
STATE = DIR + "/preset.json"
BEFORE = DIR + "/preset-before.json"
LIVE = HOME + "/.cache/rice/preset-live.json"
UI = "Google Sans Flex"


def P(name, desc, wall, theme, extra, bar, launcher, clock, dock, lock, sddm, tags):
    return {"name": name, "desc": desc, "wallpaper": wall, "theme": theme, "extra": extra, "bar": bar,
            "launcher": launcher, "clock": clock, "dock": dock, "lock": lock, "sddm": sddm, "tags": tags}


def T(colors, corners, shape, wavy, motion, bounce, bar, bar_op, widgets, notify, nr, rounding, gi, go, border, preview):
    return {"colors": colors, "corners": corners, "shape": shape, "wavy": wavy, "motion": motion, "bounce": bounce,
            "bar": bar, "bar_opacity": bar_op, "widgets": widgets, "notify": notify, "notify_radius": nr,
            "rounding": rounding, "gaps_in": gi, "gaps_out": go, "border": border, "font": UI, "preview": preview}


